{
  "name": "ai-video-studio-backend",
  "version": "1.0.0",
  "description": "AI Video Studio - Enterprise-Grade AI Video Generation Engine",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start": "node dist/server.js",
    "test:short": "ts-node src/cli/testShort.ts",
    "test:long": "ts-node src/cli/testLong.ts",
    "test:scene": "ts-node src/cli/testSingleScene.ts",
    "test:engine": "ts-node src/tests/engine.test.ts",
    "test:phase2": "ts-node src/tests/phase2.test.ts",
    "migrate": "ts-node src/database/migrationRunner.ts"
  },
  "keywords": ["ai", "video", "gemini", "veo", "shorts", "reels", "youtube"],
  "author": "AI Video Studio Team",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.18.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "fluent-ffmpeg": "^2.1.3",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "uuid": "^11.0.5",
    "zod": "^3.24.2",
    "p-limit": "^6.2.0",
    "bcryptjs": "^3.0.2",
    "pg": "^8.13.3",
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/uuid": "^10.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.11.11",
    "@types/better-sqlite3": "^7.6.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
