# AI Video Studio - Environment Configuration
PORT=3000
NODE_ENV=development

# Google Gemini & Veo API Credentials
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Model Configurations
# Gemini Director Model
GEMINI_MODEL=gemini-2.5-flash

# Veo 3.1 Video Generation Model
VEO_MODEL=veo-3.1-generate-preview

# Storage Configuration
STORAGE_DIR=./storage/media
MAX_CONCURRENT_VEO_JOBS=2

# Polling Interval (in milliseconds)
VEO_POLL_INTERVAL_MS=10000
VEO_MAX_POLL_TIME_MS=300000
